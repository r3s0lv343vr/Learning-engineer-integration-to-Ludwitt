# Ludwitt Creator OAuth (from Create app success screen)
LUDWITT_CLIENT_ID=
LUDWITT_CLIENT_SECRET=
LUDWITT_APP_ID=
LUDWITT_BASE_URL=https://pitchrise.ludwitt.com

# Public app origin (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AI Investment Learning Simulator

# Session cookie signing
SESSION_SECRET=replace-with-a-long-random-string

# Optional: cohort JWT launch bridge (reference API / platform)
LUDWITT_JWT_SECRET=
LUDWITT_API_KEY=
LUDWITT_API_URL=https://ludwitt-api.vercel.app

# Optional: real headlines (falls back to curated near-real feed)
FINNHUB_API_KEY=
